<script>
  (function () {
    var toast = document.getElementById('toast');
    var toastTimer = null;

    function showToast(message) {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('is-visible');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function () {
        toast.classList.remove('is-visible');
      }, 2200);
    }

    /* ---- Copy email to clipboard ---- */
    var emailBtn = document.getElementById('pillEmailBtn');
    if (emailBtn) {
      emailBtn.addEventListener('click', function () {
        var email = emailBtn.getAttribute('data-email');

        function done() { showToast('Email copied to clipboard ✓'); }
        function fail() { showToast('Could not copy — ' + email); }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(email).then(done).catch(fail);
        } else {
          var temp = document.createElement('textarea');
          temp.value = email;
          temp.setAttribute('readonly', '');
          temp.style.position = 'fixed';
          temp.style.opacity = '0';
          document.body.appendChild(temp);
          temp.focus();
          temp.select();
          try {
            document.execCommand('copy');
            done();
          } catch (err) {
            fail();
          }
          document.body.removeChild(temp);
        }
      });
    }

    /* ---- Projects directory modal ---- */
    var projectsBtn = document.getElementById('pillProjectsBtn');
    var overlay = document.getElementById('projectsOverlay');
    var closeBtn = document.getElementById('projectsCloseBtn');
    var lastFocused = null;

    function openModal() {
      if (!overlay) return;
      lastFocused = document.activeElement;
      overlay.hidden = false;
      projectsBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        overlay.classList.add('is-visible');
      });
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      if (!overlay || overlay.hidden) return;
      overlay.classList.remove('is-visible');
      projectsBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(function () {
        overlay.hidden = true;
        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      }, 200);
    }

    if (projectsBtn) projectsBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    if (overlay) {
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeModal();
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay && !overlay.hidden) {
        closeModal();
      }
    });
  })();
</script>