<script>
  (function () {
    function showToast(message) {
      var toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add('is-visible');
      clearTimeout(showToast._timer);
      showToast._timer = setTimeout(function () {
        toast.classList.remove('is-visible');
      }, 2200);
    }

    var brandBtn = document.getElementById('pillBrandBtn');
    var popover = document.getElementById('quickPopover');
    var popoverLastFocused = null;

    function openPopover() {
      if (!popover) return;
      popoverLastFocused = document.activeElement;
      popover.hidden = false;
      brandBtn.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(function () {
        popover.classList.add('is-visible');
      });
      var firstItem = popover.querySelector('.quick-popover__item');
      if (firstItem) firstItem.focus();
    }

    function closePopover(restoreFocus) {
      if (!popover || popover.hidden) return;
      popover.classList.remove('is-visible');
      brandBtn.setAttribute('aria-expanded', 'false');
      setTimeout(function () {
        popover.hidden = true;
        if (restoreFocus && popoverLastFocused && typeof popoverLastFocused.focus === 'function') {
          popoverLastFocused.focus();
        }
      }, 150);
    }

    if (brandBtn && popover) {
      brandBtn.addEventListener('click', function () {
        if (popover.hidden) {
          openPopover();
        } else {
          closePopover(true);
        }
      });

      document.addEventListener('click', function (e) {
        if (popover.hidden) return;
        if (popover.contains(e.target) || brandBtn.contains(e.target)) return;
        closePopover(false);
      });
    }

    var emailBtn = document.getElementById('popoverEmailBtn');
    if (emailBtn) {
      emailBtn.addEventListener('click', function () {
        var email = emailBtn.getAttribute('data-email');
        function done() { showToast('Email copied to clipboard ✓'); }
        function fail() { showToast('Could not copy — ' + email); }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(email).then(done).catch(fail);
        } else {
          var temp = document.createElement('textarea');
          temp.value = email;
          temp.setAttribute('readonly', '');
          temp.style.position = 'fixed';
          temp.style.opacity = '0';
          document.body.appendChild(temp);
          temp.focus();
          temp.select();
          try {
            document.execCommand('copy');
            done();
          } catch (err) {
            fail();
          }
          document.body.removeChild(temp);
        }
        closePopover(true);
      });
    }

    var projectsBtn = document.getElementById('popoverProjectsBtn');
    var overlay = document.getElementById('projectsOverlay');
    var closeBtn = document.getElementById('projectsCloseBtn');
    var modalLastFocused = null;

    function openModal() {
      if (!overlay) return;
      modalLastFocused = document.activeElement;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        overlay.classList.add('is-visible');
      });
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      if (!overlay || overlay.hidden) return;
      overlay.classList.remove('is-visible');
      document.body.style.overflow = '';
      setTimeout(function () {
        overlay.hidden = true;
        if (modalLastFocused && typeof modalLastFocused.focus === 'function') modalLastFocused.focus();
      }, 200);
    }

    if (projectsBtn) {
      projectsBtn.addEventListener('click', function () {
        closePopover(false);
        openModal();
      });
    }
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    if (overlay) {
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeModal();
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (overlay && !overlay.hidden) {
        closeModal();
      } else if (popover && !popover.hidden) {
        closePopover(true);
      }
    });
  })();
</script>