<header class="site-header">
  <div class="site-header__inner">
    <div class="brand">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 48 48" width="30" height="30" fill="none">
          <path d="M6 40 Q 14 10 24 10 Q 34 10 42 40" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="1 7"/>
          <circle cx="24" cy="10" r="4" fill="currentColor"/>
          <circle cx="6" cy="40" r="3" fill="currentColor"/>
          <circle cx="42" cy="40" r="3" fill="currentColor"/>
        </svg>
      </span>
      <div class="brand__text">
        <h1 class="brand__title">Route 196</h1>
        <span class="brand__badge">A Cozy Route &amp; Site Inspector</span>
      </div>
    </div>

    <button type="button" class="theme-toggle" id="themeToggle" role="switch" aria-checked="true" aria-label="Toggle between Mocha (dark) and Latte (light) theme">
      <span class="theme-toggle__track">
        <span class="theme-toggle__icon theme-toggle__icon--moon">☾</span>
        <span class="theme-toggle__icon theme-toggle__icon--sun">☀</span>
        <span class="theme-toggle__thumb"></span>
      </span>
      <span class="theme-toggle__label" id="themeLabel">Mocha</span>
    </button>
  </div>
</header>
